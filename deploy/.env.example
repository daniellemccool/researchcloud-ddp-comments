# Example values only. The init script (Task 6) writes the real deploy/.env.
# Absolute path of the desk directory on the data volume; init.sh.
DESK_ROOT=/data/example-volume/desk
# The workspace's public name; init.sh, from the SRC workspace.
FQDN=workspace.example.src.surf-hosted.nl
# Image namespace; init.sh.
GHCR_NS=ghcr.io/daniellemccool/researchcloud-ddp-comments
# Pinned desk image; init.sh, from the release it installs.
DESK_IMAGE=${GHCR_NS}/desk:v0.1.0-alpha.1
# Pinned collector proxy image; init.sh, from the release it installs.
DESKPROXY_IMAGE=${GHCR_NS}/deskproxy:v0.1.0-alpha.1
# Pinned 4CAT image (Docker Hub stable at the time of pinning); init.sh.
FOURCAT_IMAGE=digitalmethodsinitiative/4cat:v1.57
# 4CAT's database password; init.sh generates it.
POSTGRES_PASSWORD=example-only
# Where the platform copied this repository; init.sh writes the real path.
REPO_ROOT=/rsc/plugins/ddp-comments
