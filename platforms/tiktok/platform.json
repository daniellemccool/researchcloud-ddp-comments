{"name": "tiktok", "label": "TikTok",
 "zeeschuimer_modules": ["tiktok-comments", "tiktok"],
 "upload_hint": "press <b>to 4CAT</b> on <i>TikTok (comments)</i>, then on <i>TikTok</i>, and wait until both say they're done",
 "item_kinds": {"video": {"url": "https://www.tiktok.com/@x/video/{id}/", "id": "^[0-9]+$"}},
 "default_kind": "video", "hosts": ["tiktok.com"],
 "open_pattern": "^/@[^/]+/(video|photo)/(?P<id>[0-9]+)",
 "captures": [{"name": "comments", "path": "^/api/comment/list", "items": "comments", "id": "cid",
   "post_id": {"from": "query", "param": "aweme_id"}, "query_keep": ["aweme_id", "cursor", "count"],
   "response_keep": ["has_more", "cursor", "total", "status_code"],
   "fields": {"text": "text", "author": "user.unique_id", "author_nickname": "user.nickname", "author_uid": "user.uid",
              "created": "create_time", "likes": "digg_count", "reply_to": "reply_id", "reply_total": "reply_comment_total",
              "language": "comment_language"},
   "no_stream": true}],
 "login": "none",
 "keep_cookies": [{"host": ".tiktok.com", "name": "cookie-consent"}, {"host": "www.tiktok.com", "name": "cookie-consent"}, {"host": ".www.tiktok.com", "name": "cookie-consent"}],
 "problems": [{"code": "U", "label": "Video unavailable or removed"}, {"code": "P", "label": "Private video"},
   {"code": "L", "label": "Needs a login to view"}, {"code": "W", "label": "Login wall cut the comments short"},
   {"code": "R", "label": "Not available in this region"},
   {"code": "C", "label": "Captcha or blank page: stop for today and tell {contact}"},
   {"code": "X", "label": "Something else (add a note)", "note": true}]}
